# --- Supabase (cible de persistance) ---
# Laisser vide pour faire tourner RIXZA Finance OS sur les données locales.
# Renseigner pour pointer la couche de données vers un vrai projet Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Côté serveur uniquement. Pour les scripts / le seeding. Ne jamais exposer au navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# --- Connexion locale (mode données locales, sans Supabase) ---
# Secret HMAC du cookie de session. À changer en production.
APP_SESSION_SECRET=

# Identifiants d'accès. Deux options :
#  1) un seul utilisateur (rôle OWNER par défaut, ou APP_AUTH_ROLE) :
APP_AUTH_EMAIL=
APP_AUTH_PASSWORD=
APP_AUTH_NAME=
APP_AUTH_ROLE=
#  2) plusieurs, format "email:motdepasse:ROLE,email:motdepasse:ROLE"
#     ROLE = OWNER | ADMIN | FINANCE | MANAGER | VIEWER
#     OWNER / ADMIN / FINANCE peuvent saisir les données ; MANAGER / VIEWER = lecture seule.
APP_AUTH_USERS=
# Par défaut (aucune variable ci-dessus) :
#   owner@rixza.local  / rixza   (OWNER)
#   admin@rixza.local  / rixza   (ADMIN)
#   viewer@rixza.local / rixza   (VIEWER)

# --- Application ---
# Devise de reporting : XAF (FCFA).
NEXT_PUBLIC_BASE_CURRENCY=XAF

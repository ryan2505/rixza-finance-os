# ===== RIXZA Finance OS — variables d'environnement =====
# En local : copier vers .env.local et renseigner.
# Sur Vercel : Project Settings -> Environment Variables.

# --- Connexion (cookie de session signe, HMAC-SHA256) ---
# Obligatoire en production. Generer :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SESSION_SECRET=

# Comptes. Format "email:motdepasse:ROLE" separes par des virgules.
# ROLE = OWNER | ADMIN | FINANCE | MANAGER | VIEWER
# OWNER / ADMIN / FINANCE peuvent saisir les donnees ; MANAGER / VIEWER = lecture seule.
APP_AUTH_USERS=
# Raccourci un seul utilisateur (role OWNER par defaut, ou APP_AUTH_ROLE) :
APP_AUTH_EMAIL=
APP_AUTH_PASSWORD=
APP_AUTH_NAME=
APP_AUTH_ROLE=
# Par defaut (aucune des variables ci-dessus) :
#   owner@rixza.local  / rixza  (OWNER)
#   admin@rixza.local  / rixza  (ADMIN)
#   viewer@rixza.local / rixza  (VIEWER)

# --- Stockage des donnees ---
# Vide => fichier local data/dataset.local.json (dev uniquement).
# Renseigne => Supabase, une ligne JSONB dans la table app_data. OBLIGATOIRE sur Vercel.
# 1) Creer un projet Supabase, executer supabase/migrations/0001_init.sql.
# 2) Project Settings -> API : URL du projet + cle "service_role" (secrete, cote serveur).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
